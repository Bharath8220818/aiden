# ─────────────────────────────────────────────────────────────────────────
# AIDEN — EditorConfig
# Consistent editor settings across the whole team.
# See https://editorconfig.org
# ─────────────────────────────────────────────────────────────────────────

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ── Python ─────────────────────────────────────────────────────────────

[*.py]
indent_size = 4
indent_style = space
max_line_length = 100

[*.pyi]
indent_size = 4
indent_style = space

# ── JavaScript / TypeScript / React ────────────────────────────────────

[*.{js,jsx,ts,tsx}]
indent_size = 2
indent_style = space
max_line_length = 100

[*.{cjs,mjs}]
indent_size = 2
indent_style = space

# ── Web ────────────────────────────────────────────────────────────────

[*.{html,css,scss,less}]
indent_size = 2
indent_style = space

# ── Configuration / Data ──────────────────────────────────────────────

[*.{json,jsonc,json5}]
indent_size = 2
indent_style = space

[*.{yaml,yml}]
indent_size = 2
indent_style = space

[*.{xml,xsd,xsl,xhtml}]
indent_size = 2
indent_style = space

[*.{toml,ini,cfg}]
indent_size = 4
indent_style = space

# ── Markdown / Docs ───────────────────────────────────────────────────

[*.{md,mdx,rst,adoc}]
indent_size = 2
indent_style = space
trim_trailing_whitespace = false  # preserve trailing spaces for line breaks

# ── Docker / Shell ────────────────────────────────────────────────────

[Dockerfile]
indent_size = 4
indent_style = space

[*.{sh,bash,zsh}]
indent_size = 4
indent_style = space

[*.{ps1,psm1}]
indent_size = 4
indent_style = space

# ── Makefile (tabs required) ──────────────────────────────────────────

[Makefile]
indent_style = tab
indent_size = 4

# ── Binary / large files ─────────────────────────────────────────────

[*.{png,jpg,jpeg,gif,svg,ico,woff,woff2,eot,ttf,otf,pdf,zip,tar,gz}]
insert_final_newline = false
trim_trailing_whitespace = false
charset = unset
