# ═══════════════════════════════════════════════════════════════════════
# AIDEN Frontend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# Backend API URL (local dev — the Vite dev server proxies /api here)
VITE_API_URL=http://localhost:8000

# WebSocket URL for real-time pipeline updates
VITE_WS_URL=ws://localhost:8000

# Supabase (for email + GitHub OAuth login)
VITE_SUPABASE_URL=https://whjstcclxklikppvvwfr.supabase.co
# Supabase renamed "anon key" → "publishable key" in 2025.
# Either name works — supabase.ts reads both, preferring ANON_KEY.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
