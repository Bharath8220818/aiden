# AIDEN Frontend Environment Configuration Example
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
VITE_APP_ENV=development
# Phase F: mock mode OFF — the app talks to the real FastAPI backend.
# Services keep their in-browser fallbacks for offline demos only.
VITE_ENABLE_MOCK_DATA=false
