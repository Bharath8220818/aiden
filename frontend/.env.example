# ═══════════════════════════════════════════════════════════════════════
# AIDEN Frontend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# Backend API URL (local dev — the Vite dev server proxies /api here)
VITE_API_URL=http://localhost:8000

# WebSocket URL for real-time pipeline updates
VITE_WS_URL=ws://localhost:8000

# Supabase (optional — leave blank if using local backend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
