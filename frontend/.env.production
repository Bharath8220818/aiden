# Vite build-time configuration for production builds (loaded automatically
# by `vite build` — mode "production"). Committed because it contains routing
# configuration only, no secrets.
#
# API: deliberately NOT set — the deployed site calls /api/v1 on its own
# origin and the Vercel rewrite (frontend/vercel.json) proxies it to Render.
VITE_ENABLE_MOCK_DATA=false
VITE_APP_ENV=production
# WebSocket: Vercel rewrites cannot proxy WebSocket upgrades, so the realtime
# channel goes directly to the Render backend.
VITE_WS_URL=wss://aiden-backend-fq08.onrender.com/api/v1/ws
