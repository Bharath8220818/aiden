# AIDEN Frontend — PRODUCTION environment template (Vercel)
# Set these in the Vercel project settings — never commit real values.

# Render backend base URL (no trailing slash)
VITE_API_URL=https://your-api.onrender.com/api/v1
# WebSocket — wss:// in production
VITE_WS_URL=wss://your-api.onrender.com/api/v1/ws
VITE_ENABLE_MOCK_DATA=false
VITE_APP_ENV=production
