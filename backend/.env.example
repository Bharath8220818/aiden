# ============================================================
# AIDEN Backend environment configuration (example)
# Copy to `.env` and fill in your own values. NEVER commit .env.
# ============================================================

# Application
APP_NAME=AIDEN Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# API prefix (frontend calls /api/v1/...)
API_PREFIX=/api/v1

# Database — async SQLAlchemy URL
# PostgreSQL (default target)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aiden
# Local fallback without a server (development/tests):
# DATABASE_URL=sqlite+aiosqlite:///./aiden_dev.db

# Secrets — REQUIRED in production
SECRET_KEY=generate-me-with-openssl-rand-hex-32
JWT_SECRET=generate-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auxiliary / AI services (optional — leave empty to skip health checks)
OLLAMA_URL=http://localhost:11434
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Execution — Airflow (optional; empty = execution adapter reports 'unavailable')
# With the compose profile: AIRFLOW_URL=http://airflow-webserver:8080
AIRFLOW_URL=
AIRFLOW_USERNAME=aiden
AIRFLOW_PASSWORD=aiden
# Shared folder the Airflow scheduler watches for AIDEN-generated DAGs
AIRFLOW_DAGS_FOLDER=./airflow/dags

# Integration gateway — notification channels (all optional; degrade independently)
# Email via SMTP (Outlook: smtp.office365.com, Gmail: smtp.gmail.com, SES: email-smtp.<region>.amazonaws.com)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=aiden@acme.io
# Team chat webhooks (Slack Incoming Webhook / Teams Power Automate)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# Public base URL used in notification deep links ("Review in AIDEN")
FRONTEND_URL=http://localhost:5173
# --- Jira (MCP/REST adapter, optional) ---
# JIRA_URL=https://yourorg.atlassian.net
# JIRA_EMAIL=aiden@yourorg.com
# JIRA_API_TOKEN=your-api-token
# JIRA_PROJECT_KEY=AIDEN
