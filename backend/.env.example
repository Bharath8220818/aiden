# ═══════════════════════════════════════════════════════════════════════
# AIDEN Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────
APP_NAME=AIDEN
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=change-me-to-a-random-string

# ── Database ─────────────────────────────────────────────────────────
# SQLite (quick start, no install):
DATABASE_URL=sqlite+aiosqlite:///./aiden.db
#
# PostgreSQL (via Docker Compose):
# DATABASE_URL=postgresql+asyncpg://aiden:aiden123@localhost:5432/aiden
#
# Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# ── Redis (optional — for Celery task queue) ─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant Vector DB (optional — for RAG) ───────────────────────────
# Start the server: docker compose -f infrastructure/docker/docker-compose.yml up -d qdrant
# Use 127.0.0.1 (not localhost) on Windows to avoid the Docker Desktop port
# proxy resolving to ::1 and intermittently refusing connections at boot.
QDRANT_URL=http://127.0.0.1:6333
# Set False to force the in-memory RAG store (used by tests/CI)
QDRANT_ENABLED=True

# ── MinIO / S3 Storage (optional) ───────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aiden-pipelines

# ── LLM (Ollama — local inference, no API key needed) ───────────────
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3

# ── JWT Authentication ───────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── CORS — allowed frontend origins (comma-separated list) ───────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# ── HuggingFace (required for AI agent features) ───────────────────
HF_TOKEN=
HF_CACHE_DIR=./models/cache
USE_4BIT_QUANTIZATION=True

# ── Model Selection (HuggingFace model IDs) ─────────────────────────
INTENT_MODEL=meta-llama/Llama-3.2-3B-Instruct
# Optional: point at a fine-tuned LoRA adapter (output of scripts/train_agent.py
# --agent intent) to have the intent parser load it automatically.
# INTENT_ADAPTER_PATH=./models/intent-parser
AGENT_MODEL=HuggingFaceTB/SmolAgent
CODE_MODEL=HuggingFaceH4/starchat-beta
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG (Retrieval-Augmented Generation) ─────────────────────────────
RAG_TOP_K=3
RAG_MIN_SCORE=0.5
QDRANT_COLLECTION=pipeline_intents

# ── Supabase (optional — alternative to local DB) ────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
