# Application Configuration
APP_NAME=AIDEN
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./aiden.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://aiden:change-me@postgres:5432/aiden
# Supabase example:
# DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# HuggingFace / AI
HF_TOKEN=
HF_CACHE_DIR=./models/cache
USE_4BIT_QUANTIZATION=True
INTENT_MODEL=meta-llama/Llama-3.2-3B-Instruct
AGENT_MODEL=HuggingFaceTB/SmolAgent
CODE_MODEL=HuggingFaceH4/starchat-beta
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333

# MinIO (S3 Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aiden-pipelines

# LLM (Ollama)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
