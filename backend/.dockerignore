# ── Python ──────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.tox/
.mypy_cache/
.ruff_cache/

# ── Model cache (HuggingFace downloads, can be GBs) ────────────────
models/cache/

# ── Node (accidentally in backend) ────────────────────────────────
node_modules/

# ── Local dev artifacts ─────────────────────────────────────────────
.env
*.db
*.db-shm
*.db-wal
backend.log
nul

# ── IDE / OS ────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Git ─────────────────────────────────────────────────────────────
.git/
.gitignore

# ── Documentation (not needed at runtime) ───────────────────────────
*.md

# ── Dev/test files (not needed in production image) ─────────────────
tests/
pytest.ini

# ── Docker files (avoid recursive copies) ──────────────────────────
Dockerfile
.dockerignore

# ── Data files (not needed in production) ──────────────────────────
data/

# ── Training artifacts ─────────────────────────────────────────────
models/adapters/
models/训练

