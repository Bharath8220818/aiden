# ── Quality Checks ─────────────────────────────────────────────────────────
def quality_check(df: DataFrame) -> bool:
    """Run data quality checks."""
    total = df.count()
    null_counts = df.select([count(when(isnull(c), c)).alias(c) for c in df.columns]).collect()[0]
    passed = all(null_counts[c] == 0 for c in df.columns if c in ("id", "key"))
    return passed


