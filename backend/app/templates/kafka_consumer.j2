import json
import logging
from typing import Dict, Any, Callable

from confluent_kafka import Consumer, KafkaError, KafkaException

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


class StreamConsumer:
    """Kafka consumer for pipeline ingestion."""

    def __init__(
        self,
        bootstrap_servers: str = "localhost:9092",
        group_id: str = "aiden_{{ pipeline_name | replace(' ', '_') | lower }}",
        topics: list = None,
    ):
        self.conf = {
            "bootstrap.servers": bootstrap_servers,
            "group.id": group_id,
            "auto.offset.reset": "earliest",
            "enable.auto.commit": True,
        }
        self.topics = topics or ["{{ kafka_topic }}"]
        self.consumer = Consumer(self.conf)
        self.consumer.subscribe(self.topics)
        logger.info("Subscribed to topics: %s", self.topics)

    def process(self, transform_fn: Callable[[Dict[str, Any]], Dict[str, Any]] = None):
        """Continuously consume and process messages."""
        try:
            while True:
                msg = self.consumer.poll(timeout=1.0)
                if msg is None:
                    continue
                if msg.error():
                    if msg.error().code() == KafkaError._PARTITION_EOF:
                        continue
                    else:
                        raise KafkaException(msg.error())

                # Decode and process
                value = json.loads(msg.value().decode("utf-8"))
                if transform_fn:
                    value = transform_fn(value)

                logger.debug("Processed: %s", value)

        except KeyboardInterrupt:
            logger.info("Shutting down consumer...")
        finally:
            self.consumer.close()


