# AIDEN Backend — PRODUCTION environment template
# Copy every value into the Render dashboard (or your secret manager) — never
# commit a real .env. Variable names match app/core/config.py exactly.

# --- Core ------------------------------------------------------------- #
ENVIRONMENT=production
# Supabase session pooler (port 5432), postgres:// or postgresql:// form —
# the app rewrites it to postgresql+asyncpg:// automatically.
DATABASE_URL=
# 64-hex random — generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS / origins --------------------------------------------------- #
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# --- Supabase (optional, for Storage/Auth integrations) --------------- #
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- RAG infrastructure (Render internal URLs from render.yaml) ------- #
QDRANT_URL=http://aiden-qdrant:6333
QDRANT_COLLECTION=aiden_knowledge
OLLAMA_URL=http://aiden-ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Optional until Phase D ------------------------------------------- #
REDIS_URL=
AIRFLOW_URL=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=

# --- Notification providers (all optional; off = honest degradation) -- #
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
