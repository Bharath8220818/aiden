# ============================================================
# AIDEN — root environment (docker-compose / local scripts)
# Per-app env lives in backend/.env and frontend/.env —
# copy those from their .env.example files. NEVER commit real .env.
# ============================================================

# --- Compose data services (development defaults) ---
POSTGRES_USER=aiden
POSTGRES_PASSWORD=aiden_local
POSTGRES_DB=aiden

# Backend container wiring (see backend/.env.example for the full set)
DATABASE_URL=postgresql+asyncpg://aiden:aiden_local@postgres:5432/aiden
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434

# Dev-safe secrets — compose is a development environment.
SECRET_KEY=aiden-insecure-dev-secret-change-me
JWT_SECRET=aiden-insecure-dev-jwt-change-me

# Airflow (Sprint 4) — leave empty to report mode: unavailable
AIRFLOW_URL=
AIRFLOW_USERNAME=aiden
AIRFLOW_PASSWORD=aiden

# Frontend build args (compose build)
VITE_API_URL=/api/v1
VITE_WS_URL=ws://localhost:5174/api/v1/ws
