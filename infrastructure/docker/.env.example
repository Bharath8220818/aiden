# ──────────────────────────────────────────────────────────────
# AIDEN — Docker Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# cp .env.example .env
# ──────────────────────────────────────────────────────────────

# == PostgreSQL ==
POSTGRES_PASSWORD=change_me_secure_password

# == Redis ==
REDIS_PASSWORD=change_me_secure_redis_password

# == MinIO (S3-compatible Storage) ==
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# == JWT (Authentication) ==
JWT_SECRET_KEY=change_me_to_a_random_64_char_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# == Hugging Face (AI Models & Embeddings) ==
# Required for: intent parsing, code generation, RAG embeddings, agent orchestration
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=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

# == LLM Provider (Ollama — local) ==
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3

# == Supabase (optional — for auth persistence) ==
SUPABASE_URL=https://whjstcclxklikppvvwfr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_d7-EeOOW-_A3om2EJgJilA_T2VgRjGm

# == Backend Config ==
DEBUG=True
CORS_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost:5174,http://localhost:3000
SECRET_KEY=change_me_to_a_random_string

# == Seed Users (created on first startup) ==
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=demo1234
